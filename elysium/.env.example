# Public hostname of the explorer (no protocol). Use "localhost" for a local test.
EXPLORER_HOST=explorer.yourdomain.com
EXPLORER_PROTOCOL=https
EXPLORER_WS_PROTOCOL=wss
# Only set when the explorer is served on a non-standard port (e.g. 8080 for a local test)
EXPLORER_PUBLIC_PORT=

# Port the bundled nginx listens on. Use 8080 if Caddy/another proxy owns 80/443.
HTTP_PORT=8080

# Archive node (full history) - required for balances/contract code of past blocks
RPC_URL=https://rpc.chainzy.io
# Pruned node (recent state only), used as fallback
RPC_FALLBACK_URL=https://rpc.stockium.fun

# Change these for production: openssl rand -base64 48
DB_PASSWORD=change-me
SECRET_KEY_BASE=change-me-to-a-64-char-random-string-change-me-to-a-64-char-random
