CHAIN_TYPE=arbitrum
CHAIN_ID=99901
NETWORK=Elysium
SUBNETWORK=Elysium Mainnet
COIN=HYPE
COIN_NAME=HYPE
ETHEREUM_JSONRPC_VARIANT=geth
ETHEREUM_JSONRPC_TRANSPORT=http
ETHEREUM_JSONRPC_DISABLE_ARCHIVE_BALANCES=false
# Neither public RPC exposes debug_trace*, so internal transactions cannot be fetched
INDEXER_DISABLE_INTERNAL_TRANSACTIONS_FETCHER=true
INDEXER_DISABLE_PENDING_TRANSACTIONS_FETCHER=true
ECTO_SSL_MODE=disable
ECTO_USE_SSL=false
PORT=4000
POOL_SIZE=50
POOL_SIZE_API=10
DISABLE_MARKET=true
ACCOUNT_ENABLED=false
ACCOUNT_REDIS_URL=redis://redis-db:6379
ADMIN_PANEL_ENABLED=false
API_V1_READ_METHODS_DISABLED=false
API_V1_WRITE_METHODS_DISABLED=false
TXS_STATS_DAYS_TO_COMPILE_AT_INIT=10
COIN_BALANCE_HISTORY_DAYS=90
RE_CAPTCHA_DISABLED=true
NFT_MEDIA_HANDLER_ENABLED=false
MICROSERVICE_SC_VERIFIER_ENABLED=true
MICROSERVICE_SC_VERIFIER_TYPE=eth_bytecode_db
MICROSERVICE_SC_VERIFIER_URL=https://eth-bytecode-db.services.blockscout.com/
MICROSERVICE_VISUALIZE_SOL2UML_ENABLED=false
MICROSERVICE_SIG_PROVIDER_ENABLED=false
DISABLE_FILE_LOGGING=true
HEART_BEAT_TIMEOUT=30
# rpc.chainzy.io rejects JSON-RPC batches larger than 50 requests (HTTP 403 "Invalid request")
ETHEREUM_JSONRPC_HTTP_BATCH_SIZE=50
INDEXER_RECEIPTS_BATCH_SIZE=50
INDEXER_COIN_BALANCES_BATCH_SIZE=50
INDEXER_TOKEN_BALANCES_BATCH_SIZE=50
INDEXER_CURRENT_TOKEN_BALANCES_BATCH_SIZE=50
INDEXER_ARCHIVAL_TOKEN_BALANCES_BATCH_SIZE=50
